@model IEnumerable<Joja.Api.Models.RecentOffer>

@{
    ViewData["Title"] = "Manage Recent Offers";
    var offerList = Model.OrderBy(o => o.DisplayOrder).ThenByDescending(o => o.CreatedAt).ToList();
}

<style>
    .order-btns form {
        display: inline;
    }
    .order-btns .btn {
        padding: 2px 8px;
        font-size: 0.8rem;
    }
    .offer-thumb {
        width: 80px;
        height: 65px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #ddd;
    }
    .badge-active   { background-color: #22a06b; color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; }
    .badge-inactive { background-color: #dc3545; color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; }
    .badge-discount { background-color: #78233d; color: #fff; padding: 4px 8px; border-radius: 12px; font-weight: 700; font-size: 0.8rem; }
</style>

<div class="container" style="margin-top: 50px; max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="brand-font mb-1">Recent Offers Management</h1>
            <p class="text-muted mb-0">Manage temporary promotional offers displayed on the homepage independently from product bundles.</p>
        </div>
        <a asp-action="Create" class="btn-joja-dark">+ Create New Offer</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        Offers are temporary promotions shown in the homepage <strong>Recent Offers</strong> section. 
        Only active offers within their scheduled date range are displayed publicly.
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="width:70px;">Order</th>
                    <th style="width:100px;">Image</th>
                    <th>Offer Title</th>
                    <th>Linked Product</th>
                    <th>Pricing</th>
                    <th>Discount</th>
                    <th>Schedule</th>
                    <th style="width:90px;">Status</th>
                    <th style="width:200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!offerList.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            No recent offers yet. Click "+ Create New Offer" to add your first promotion.
                        </td>
                    </tr>
                }
                @for (int i = 0; i < offerList.Count; i++)
                {
                    var item = offerList[i];
                    var cairoNow = Joja.Api.Services.TimeHelper.GetEgyptNow();
                    var isExpired = item.EndDate.HasValue && item.EndDate.Value < cairoNow;
                    var isUpcoming = item.StartDate.HasValue && item.StartDate.Value > cairoNow;

                    <tr>
                        <td>
                            <strong>@item.DisplayOrder</strong><br />
                            <span class="order-btns">
                                @if (i > 0)
                                {
                                    <form asp-action="MoveUp" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move Up">▲</button>
                                    </form>
                                }
                                @if (i < offerList.Count - 1)
                                {
                                    <form asp-action="MoveDown" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move Down">▼</button>
                                    </form>
                                }
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="offer-thumb" alt="@item.Title" />
                            }
                            else
                            {
                                <span class="text-muted small">No image</span>
                            }
                        </td>
                        <td>
                            <strong>@item.Title</strong>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="text-muted small text-truncate" style="max-width: 200px;">@item.Description</div>
                            }
                        </td>
                        <td>
                            @if (item.Product != null)
                            {
                                <a href="/Home/Details/@item.ProductId" target="_blank" class="small">
                                    @item.Product.Name
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">Standalone Offer</span>
                            }
                        </td>
                        <td>
                            <div class="small text-muted text-decoration-line-through">@item.OriginalPrice.ToString("0.##") EGP</div>
                            <div class="fw-bold" style="color:#78233d;">@item.DiscountedPrice.ToString("0.##") EGP</div>
                        </td>
                        <td>
                            <span class="badge-discount">-@item.DiscountPercentage%</span>
                        </td>
                        <td class="small">
                            @if (item.StartDate.HasValue || item.EndDate.HasValue)
                            {
                                <div>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("yyyy-MM-dd") : "Now")</div>
                                <div class="text-muted">to @(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "Ongoing")</div>
                                @if (isExpired)
                                {
                                    <span class="badge bg-secondary">Expired</span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-warning text-dark">Upcoming</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Always Active</span>
                            }
                        </td>
                        <td>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(item.IsActive ? "badge-active" : "badge-inactive") border-0" title="Click to toggle">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this offer?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
