@model Joja.Api.Models.Product

<div class="product-card">
    <div class="image-box">
        <a href="/Home/Details/@Model.Id">
            <img src="@Model.MainImageUrl" class="product-img" loading="lazy" alt="@Model.Name">
        </a>
        @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
        {
            var discPct = (int)Math.Round((1 - (double)Model.Price / (double)Model.OriginalPrice.Value) * 100);
            <span class="discount-badge">-@discPct%</span>
        }
    </div>
    <div class="product-info">
        <a href="/Home/Details/@Model.Id">
            <h5 class="product-title">@Model.Name</h5>
        </a>
        <div class="product-price-row">
            <div class="product-price">
                @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
                {
                    <span class="old-price">@Model.OriginalPrice.Value EGP</span>
                }
                <span class="new-price">@Model.Price EGP</span>
            </div>
            <div class="product-card-actions-row">
                <button type="button" class="btn-action-icon btn-add-cart-icon" onclick="addToCartAjax(@Model.Id, 1, null)" title="Add to Cart">
                    <i class="fas fa-shopping-cart"></i>
                </button>
                <button type="button" class="btn-action-icon btn-wishlist-icon wishlist-btn" data-product-id="@Model.Id" onclick="toggleWishlist(event, @Model.Id, this)" title="Add to Wishlist">
                    <i class="far fa-heart"></i>
                </button>
            </div>
        </div>
    </div>
</div>
