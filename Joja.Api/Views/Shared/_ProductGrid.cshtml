@model Joja.Api.Models.Product

<div class="product-card">
    <div class="image-box">
        <a href="/Home/Details/@Model.Id">
            <img src="@Model.MainImageUrl" class="product-img" loading="lazy" alt="@Model.Name">
        </a>
        @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
        {
            var discPct = (int)Math.Round((1 - (double)Model.Price / (double)Model.OriginalPrice.Value) * 100);
            <span class="discount-badge">-@discPct%</span>
        }
    </div>
    <div class="product-info">
        <a href="/Home/Details/@Model.Id">
            <h5 class="product-title">@Model.Name</h5>
        </a>
        <div class="product-price">
            @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
            {
                <span class="old-price">@Model.OriginalPrice.Value EGP</span>
            }
            <span class="new-price">@Model.Price EGP</span>
        </div>
        <div class="product-card-actions">
            <button type="button" class="btn-add-to-cart-card" onclick="addToCart(@Model.Id, '@Model.Name.Replace("'", "\\'")', @Model.Price, '@Model.MainImageUrl')">
                <i class="fas fa-shopping-bag me-1"></i> ADD TO CART
            </button>
            <button type="button" class="btn-wishlist-card" onclick="toggleWishlist(@Model.Id, '@Model.Name.Replace("'", "\\'")', @Model.Price, '@Model.MainImageUrl', this)" title="Add to Wishlist">
                <i class="far fa-heart"></i>
            </button>
        </div>
    </div>
</div>
