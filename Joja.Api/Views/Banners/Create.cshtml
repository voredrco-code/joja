@model Joja.Api.Models.Banner

@{
    ViewData["Title"] = "Add Banner";
}

<div class="container" style="margin-top: 50px; max-width: 900px;">
    <h1 class="brand-font">Add New Banner</h1>
    <p class="text-muted">Upload independent desktop and mobile hero banner images for optimal display across all devices.</p>
    <hr />
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Desktop Banner -->
            <div class="col-md-6 mb-3">
                <div class="card p-3 h-100 border-1">
                    <h5 class="fw-bold" style="color: #78233d;">🖥️ Desktop Banner Image *</h5>
                    <p class="small text-muted mb-2">Recommended size: <strong>2400 × 1600 px</strong> (Landscape, 3:2 aspect ratio)</p>
                    <input type="file" name="ImageFile" id="desktopImageInput" class="form-control mb-3" accept="image/*" required />
                    
                    <div style="background:#f8f9fa; border:1px dashed #ccc; border-radius:6px; min-height:120px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                        <img id="desktopPreview" src="#" alt="Desktop Preview" style="display:none; width:100%; max-height:160px; object-fit:cover;" />
                        <span id="desktopPlaceholder" class="text-muted small">No desktop image selected</span>
                    </div>
                </div>
            </div>

            <!-- Mobile Banner -->
            <div class="col-md-6 mb-3">
                <div class="card p-3 h-100 border-1">
                    <h5 class="fw-bold" style="color: #78233d;">📱 Mobile Banner Image</h5>
                    <p class="small text-muted mb-2">Recommended size: <strong>1200 × 1600 px</strong> (Portrait, 3:4 aspect ratio). Fallback uses desktop image if empty.</p>
                    <input type="file" name="MobileImageFile" id="mobileImageInput" class="form-control mb-3" accept="image/*" />

                    <div style="background:#f8f9fa; border:1px dashed #ccc; border-radius:6px; min-height:120px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                        <img id="mobilePreview" src="#" alt="Mobile Preview" style="display:none; max-width:120px; max-height:160px; object-fit:cover;" />
                        <span id="mobilePlaceholder" class="text-muted small">No mobile image selected (will use desktop fallback)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-3 mb-3 mt-3 bg-light border-0">
            <h5 class="fw-bold mb-3">Banner Details & Optional Video</h5>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label fw-bold"></label>
                <input asp-for="Title" class="form-control" placeholder="Headline text" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Subtitle" class="control-label fw-bold"></label>
                <input asp-for="Subtitle" class="form-control" placeholder="Sub-headline or description" />
                <span asp-validation-for="Subtitle" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LinkUrl" class="control-label fw-bold">Link URL (optional)</label>
                    <input asp-for="LinkUrl" class="form-control" value="#" placeholder="/Home/Shop or #" />
                    <span asp-validation-for="LinkUrl" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DisplayOrder" class="control-label fw-bold">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" value="0" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-2">
                <label class="control-label fw-bold">Video Banner (Optional)</label>
                <input type="file" name="VideoFile" class="form-control" accept="video/*" />
                <small class="text-muted">If video is uploaded, it takes priority over static images.</small>
            </div>
        </div>

        <div class="form-group mt-4 mb-5">
            <input type="submit" value="Create Banner" class="btn-joja-dark me-2" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('desktopImageInput').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function(evt) {
                    var img = document.getElementById('desktopPreview');
                    img.src = evt.target.result;
                    img.style.display = 'block';
                    document.getElementById('desktopPlaceholder').style.display = 'none';
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        document.getElementById('mobileImageInput').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function(evt) {
                    var img = document.getElementById('mobilePreview');
                    img.src = evt.target.result;
                    img.style.display = 'block';
                    document.getElementById('mobilePlaceholder').style.display = 'none';
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}
