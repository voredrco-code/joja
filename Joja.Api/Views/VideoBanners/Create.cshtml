@model Joja.Api.Models.VideoBanner

@{
    ViewData["Title"] = "Add Customer Feedback Banner";
}

<div class="container" style="margin-top: 50px;">
    <h1 class="brand-font" style="color: #78233d;">Add Customer Feedback Item (صورة رأي عميل)</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Title" class="control-label">Title / Customer Name</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Review screenshot 1" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DisplayOrder" class="control-label">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" value="1" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IsActive" class="control-label">Active</label>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="VideoUrl" class="control-label">Media / Image URL (Optional: Paste external link if not uploading a file)</label>
                    <input asp-for="VideoUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="VideoUrl" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Upload Review Image / Video (رفع صورة رأي العميل)</label>
                    <input type="file" name="VideoFile" class="form-control" accept="image/*,video/*" />
                    <small class="text-muted">You can upload screenshot images (.png, .jpg, .webp) or videos. Uploaded file overrides the URL above.</small>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Create" class="btn-joja-dark" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
