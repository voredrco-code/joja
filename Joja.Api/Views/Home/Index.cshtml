@model Joja.Api.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- ========================
     Hero Carousel Section
     ======================== -->
@if (Model.Banners != null && Model.Banners.Any())
{
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Banners.Count(); i++)
            {
                var banner = Model.Banners.ElementAt(i);
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="hero-section" style="background-image: url('@banner.ImageUrl');">
                        <div class="container hero-content">
                            <h1>@banner.Title</h1>
                            <p>@banner.Subtitle</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.Banners.Count() > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>
}
else
{
    <div class="hero-section" style="background-image: url('/images/logo.webp');">
        <div class="container hero-content">
            <h1>@(ViewBag.HeroTitle ?? "Natural Beauty for You")</h1>
            <p>@(ViewBag.HeroSubtitle ?? "Discover our natural collection")</p>
        </div>
    </div>
}

<!-- ========================
     Recent Offers Section
     ======================== -->
@if (Model.RecentOffers != null && Model.RecentOffers.Any())
{
    <div class="home-section" id="recent-offers">
        <div class="container">
            <div class="home-section-header">
                <div class="home-section-title-group">
                    <span class="home-section-label">✨ Limited Time</span>
                    <h2 class="home-section-title">Recent Offers</h2>
                </div>
                <a href="/#shop-section" class="home-section-view-all">View All &rarr;</a>
            </div>
            <div class="product-row-grid">
                @foreach (var item in Model.RecentOffers)
                {
                    <div class="product-card">
                        <div class="image-box">
                            <a href="/Home/Details/@item.Id">
                                <img src="@item.MainImageUrl" class="product-img" loading="lazy" alt="@item.Name">
                            </a>
                            @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                            {
                                var discPct = (int)Math.Round((1 - (double)item.Price / (double)item.OriginalPrice.Value) * 100);
                                <span class="discount-badge">-@discPct%</span>
                            }
                        </div>
                        <div class="product-info">
                            <a href="/Home/Details/@item.Id">
                                <h5 class="product-title">@item.Name</h5>
                            </a>
                            <div class="product-price">
                                @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                {
                                    <span class="old-price">@item.OriginalPrice.Value EGP</span>
                                }
                                <span class="new-price">@item.Price EGP</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ========================
     Category Sections
     ======================== -->
@if (Model.CategorySections != null && Model.CategorySections.Any())
{
    @foreach (var catSection in Model.CategorySections)
    {
        <div class="home-section" id="category-@catSection.CategoryId">
            <div class="container">
                <div class="home-section-header">
                    <div class="home-section-title-group">
                        <span class="home-section-label">Our Collection</span>
                        <h2 class="home-section-title">@catSection.CategoryName</h2>
                    </div>
                    <a href="/?categoryId=@catSection.CategoryId#shop-section" class="home-section-view-all">View All &rarr;</a>
                </div>
                <div class="product-row-grid">
                    @foreach (var item in catSection.Products)
                    {
                        <div class="product-card">
                            <div class="image-box">
                                <a href="/Home/Details/@item.Id">
                                    <img src="@item.MainImageUrl" class="product-img" loading="lazy" alt="@item.Name">
                                </a>
                                @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                {
                                    var discPct2 = (int)Math.Round((1 - (double)item.Price / (double)item.OriginalPrice.Value) * 100);
                                    <span class="discount-badge">-@discPct2%</span>
                                }
                            </div>
                            <div class="product-info">
                                <p class="product-category-label">@catSection.CategoryName</p>
                                <a href="/Home/Details/@item.Id">
                                    <h5 class="product-title">@item.Name</h5>
                                </a>
                                <div class="product-price">
                                    @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                    {
                                        <span class="old-price">@item.OriginalPrice.Value EGP</span>
                                    }
                                    <span class="new-price">@item.Price EGP</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Fallback: All Products with Filter Buttons -->
    <div id="shop-section" class="container mt-5 mb-5">
        <h2 class="text-center mb-4" style="color: #333; font-weight: 800; font-size: 2.2rem;">Our Products</h2>

        <div class="filter-buttons filter-list my-4 d-flex justify-content-center flex-wrap gap-2">
            <button class="btn-filter active" onclick="filter(null)">@(ViewBag.FilterAll ?? "All")</button>
            @foreach (var cat in Model.Categories)
            {
                <button class="btn-filter" onclick="filter(@cat.Id)">@cat.Name</button>
            }
        </div>

        <div class="desktop-4-grid" id="product-container">
            @foreach (var item in Model.Products)
            {
                <div class="product-card">
                    <div class="image-box">
                        <a href="/Home/Details/@item.Id">
                            <img src="@item.MainImageUrl" class="product-img" loading="lazy" alt="@item.Name">
                        </a>
                        @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                        {
                            var discPct3 = (int)Math.Round((1 - (double)item.Price / (double)item.OriginalPrice.Value) * 100);
                            <span class="discount-badge">-@discPct3%</span>
                        }
                    </div>
                    <div class="product-info">
                        <a href="/Home/Details/@item.Id">
                            <h5 class="product-title">@item.Name</h5>
                        </a>
                        <div class="product-price">
                            @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                            {
                                <span class="old-price">@item.OriginalPrice.Value EGP</span>
                            }
                            <span class="new-price">@item.Price EGP</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- anchor for nav links -->
<div id="shop-section" style="position:relative; top:-80px; visibility:hidden;"></div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function filter(catId) {
        var searchQuery = new URLSearchParams(window.location.search).get('searchQuery');
        $.get("/Home/FilterProducts", { categoryId: catId, searchQuery: searchQuery }, function(data) {
            $("#product-container").html(data);
        });
        $(".btn-filter").removeClass("active");
        event.target.classList.add("active");
    }
</script>
}
