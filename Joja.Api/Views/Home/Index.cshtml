@model Joja.Api.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- ========================
     Hero Carousel Section
     ======================== -->
@if (Model.Banners != null && Model.Banners.Any())
{
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Banners.Count(); i++)
            {
                var banner = Model.Banners.ElementAt(i);
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="hero-section" style="background-image: url('@banner.ImageUrl');">
                        <div class="container hero-content">
                            <h1>@banner.Title</h1>
                            <p>@banner.Subtitle</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.Banners.Count() > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>
}
else
{
    <div class="hero-section" style="background-image: url('/images/logo.png?v=3');">
        <div class="container hero-content">
            <h1>@(ViewBag.HeroTitle ?? "Natural Beauty for You")</h1>
            <p>@(ViewBag.HeroSubtitle ?? "Discover our natural collection")</p>
        </div>
    </div>
}

<!-- ========================
     Recent Offers Section
     ======================== -->
@if (Model.RecentOffers != null && Model.RecentOffers.Any())
{
    <div class="home-section" id="recent-offers">
        <div class="container">
            <div class="home-section-header">
                <div class="home-section-title-group">
                    <span class="home-section-label">✨ Limited Time</span>
                    <h2 class="home-section-title">Recent Offers</h2>
                </div>
                <a href="/Home/Shop" class="home-section-view-all">View All &rarr;</a>
            </div>
            <div class="product-row-grid">
                @foreach (var item in Model.RecentOffers)
                {
                    <div class="product-card">
                        <div class="image-box">
                            <a href="/Home/Details/@item.Id">
                                <img src="@item.MainImageUrl" class="product-img" loading="lazy" alt="@item.Name">
                            </a>
                            @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                            {
                                var discPct = (int)Math.Round((1 - (double)item.Price / (double)item.OriginalPrice.Value) * 100);
                                <span class="discount-badge">-@discPct%</span>
                            }
                        </div>
                        <div class="product-info">
                            <a href="/Home/Details/@item.Id">
                                <h5 class="product-title">@item.Name</h5>
                            </a>
                            <div class="product-price-row">
                                <div class="product-price">
                                    @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                    {
                                        <span class="old-price">@item.OriginalPrice.Value EGP</span>
                                    }
                                    <span class="new-price">@item.Price EGP</span>
                                </div>
                                <div class="product-card-actions-row">
                                    <div class="card-qty-wrap">
                                        <button type="button" class="card-qty-btn" onclick="adjustCardQty(@item.Id, -1)" aria-label="Decrease">-</button>
                                        <span class="card-qty-num" id="card-qty-@item.Id">1</span>
                                        <button type="button" class="card-qty-btn" onclick="adjustCardQty(@item.Id, 1)" aria-label="Increase">+</button>
                                    </div>
                                    <button type="button" class="btn-action-icon btn-add-cart-icon" onclick="addToCartAjax(@item.Id, getCardQty(@item.Id), null)" title="Add to Cart">
                                        <i class="fas fa-shopping-cart"></i>
                                    </button>
                                    <button type="button" class="btn-action-icon btn-wishlist-icon wishlist-btn" data-product-id="@item.Id" onclick="toggleWishlist(event, @item.Id, this)" title="Add to Wishlist">
                                        <i class="far fa-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ========================
     Category Sections
     ======================== -->
@if (Model.CategorySections != null && Model.CategorySections.Any())
{
    @foreach (var catSection in Model.CategorySections)
    {
        <div class="home-section" id="category-@catSection.CategoryId">
            <div class="container">
                <div class="home-section-header">
                    <div class="home-section-title-group">
                        <span class="home-section-label">Our Collection</span>
                        <h2 class="home-section-title">@catSection.CategoryName</h2>
                    </div>
                    <a href="/Home/Shop?categoryId=@catSection.CategoryId" class="home-section-view-all">View All &rarr;</a>
                </div>
                <div class="product-row-grid">
                    @foreach (var item in catSection.Products)
                    {
                        <div class="product-card">
                            <div class="image-box">
                                <a href="/Home/Details/@item.Id">
                                    <img src="@item.MainImageUrl" class="product-img" loading="lazy" alt="@item.Name">
                                </a>
                                @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                {
                                    var discPct2 = (int)Math.Round((1 - (double)item.Price / (double)item.OriginalPrice.Value) * 100);
                                    <span class="discount-badge">-@discPct2%</span>
                                }
                            </div>
                            <div class="product-info">
                                <a href="/Home/Details/@item.Id">
                                    <h5 class="product-title">@item.Name</h5>
                                </a>
                                <div class="product-price-row">
                                    <div class="product-price">
                                        @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                        {
                                            <span class="old-price">@item.OriginalPrice.Value EGP</span>
                                        }
                                        <span class="new-price">@item.Price EGP</span>
                                    </div>
                                    <div class="product-card-actions-row">
                                        <div class="card-qty-wrap">
                                            <button type="button" class="card-qty-btn" onclick="adjustCardQty(@item.Id, -1)" aria-label="Decrease">-</button>
                                            <span class="card-qty-num" id="card-qty-@item.Id">1</span>
                                            <button type="button" class="card-qty-btn" onclick="adjustCardQty(@item.Id, 1)" aria-label="Increase">+</button>
                                        </div>
                                        <button type="button" class="btn-action-icon btn-add-cart-icon" onclick="addToCartAjax(@item.Id, getCardQty(@item.Id), null)" title="Add to Cart">
                                            <i class="fas fa-shopping-cart"></i>
                                        </button>
                                        <button type="button" class="btn-action-icon btn-wishlist-icon wishlist-btn" data-product-id="@item.Id" onclick="toggleWishlist(event, @item.Id, this)" title="Add to Wishlist">
                                            <i class="far fa-heart"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<!-- ========================
     Customer Feedback Section
     ======================== -->
<div class="feedback-section py-5" id="customer-feedback">
    <div class="container text-center">
        <h2 class="feedback-title">CUSTOMER FEEDBACK</h2>
        <div class="feedback-stars my-2">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
            <i class="fas fa-star"></i><i class="fas fa-star"></i>
        </div>

        @{
            // Use VideoBanners as image source (images only, no video rendering)
            var feedbackImages = Model.VideoBanners?
                .Where(v => !string.IsNullOrEmpty(v.VideoUrl))
                .ToList();
            bool hasFeedbackImages = feedbackImages != null && feedbackImages.Any();
        }

        <div class="reviews-carousel-wrap mt-4">
            <div class="reviews-carousel" id="reviewsCarousel">
                @if (hasFeedbackImages)
                {
                    foreach (var fb in feedbackImages!)
                    {
                        <div class="reviews-slide">
                            <img src="@fb.VideoUrl" alt="@(fb.Title ?? "Customer Review")" class="review-slide-img" loading="lazy" />
                        </div>
                    }
                }
                else
                {
                    <!-- Fallback sample WhatsApp feedback cards -->
                    <div class="reviews-slide">
                        <div class="feedback-chat-box">
                            <div class="chat-bubble">"مساء النور.. الـ body spray حلو قوي وريحته رقيقة جداً شكراً ليكوا 🙏"</div>
                            <div class="chat-time">2:17 pm ✓✓</div>
                        </div>
                    </div>
                    <div class="reviews-slide">
                        <div class="feedback-chat-box">
                            <div class="chat-bubble">"ايوه وصل تسلمي وتوحفة، الاسبلاشر تحفه تحفه ❤️"</div>
                            <div class="chat-time">2:44 pm ✓✓</div>
                        </div>
                    </div>
                    <div class="reviews-slide">
                        <div class="feedback-chat-box">
                            <div class="chat-bubble">"المنتجات بجد فوق الوصف.. البودي زبدة بتسيب الجسم ناعم وريحته تحفة ثابتة طول اليوم! ✨"</div>
                            <div class="chat-time">4:12 pm ✓✓</div>
                        </div>
                    </div>
                    <div class="reviews-slide">
                        <div class="feedback-chat-box">
                            <div class="chat-bubble">"أول ما جرب المنتج حسيت بفرق فوري، هوصي بيه لأي حد! 💯"</div>
                            <div class="chat-time">7:30 pm ✓✓</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Dot indicators -->
            <div class="reviews-dots" id="reviewsDots"></div>
        </div>
    </div>
</div>

<script>
(function() {
    var carousel   = document.getElementById('reviewsCarousel');
    var dotsWrap   = document.getElementById('reviewsDots');
    if (!carousel) return;

    var slides     = Array.from(carousel.querySelectorAll('.reviews-slide'));
    var total      = slides.length;
    var current    = 0;
    var autoTimer  = null;
    var touchStartX = 0;

    // Build dots
    slides.forEach(function(_, i) {
        var dot = document.createElement('button');
        dot.className = 'reviews-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Slide ' + (i + 1));
        dot.addEventListener('click', function() { goTo(i); resetTimer(); });
        dotsWrap.appendChild(dot);
    });

    function goTo(idx) {
        slides[current].classList.remove('active');
        dotsWrap.children[current].classList.remove('active');
        current = (idx + total) % total;
        slides[current].classList.add('active');
        dotsWrap.children[current].classList.add('active');
    }

    function next() { goTo(current + 1); }

    function resetTimer() {
        clearInterval(autoTimer);
        autoTimer = setInterval(next, 3200);
    }

    // Init first slide
    slides[0].classList.add('active');

    // Touch / swipe support
    carousel.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
    }, { passive: true });
    carousel.addEventListener('touchend', function(e) {
        var diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) { diff > 0 ? next() : goTo(current - 1); resetTimer(); }
    }, { passive: true });

    // Start auto-play
    resetTimer();
})();
</script>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
}
